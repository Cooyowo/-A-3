{
  "name": "a3-v1",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "葵A葵3 · 四人扑克（家乡玩法）Web 版 v1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "selfplay": "vitest run packages/core/tests/selfplay.test.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "npm run dev --workspace @a3/web",
    "build": "npm run build --workspace @a3/web",
    "dev:server": "npm run dev --workspace @a3/server",
    "dev:web": "npm run dev --workspace @a3/web",
    "e2e": "vitest run apps/server/tests/e2e.test.ts"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
