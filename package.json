{
  "name": "a3-v1",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "葵A葵3 · 四人扑克（家乡玩法）Web 版 v1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
